# Copy to .env and replace the example values before running the application.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=true
COOKIE_SECURE=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your-local-mysql-user
MYSQL_PASSWORD=your-local-mysql-password
MYSQL_DATABASE=campus_lost_found
LOG_LEVEL=INFO

# Optional dedicated MySQL integration-test account.
# TEST_MYSQL_DATABASE must remain campus_lost_found_test.
TEST_MYSQL_HOST=127.0.0.1
TEST_MYSQL_PORT=3306
TEST_MYSQL_DATABASE=campus_lost_found_test
TEST_MYSQL_USER=your-test-mysql-user
TEST_MYSQL_PASSWORD=your-test-mysql-password
TEST_ACCOUNT_PASSWORD=your-test-account-password

# Optional bootstrap account.
TEST_MYSQL_ADMIN_USER=
TEST_MYSQL_ADMIN_PASSWORD=